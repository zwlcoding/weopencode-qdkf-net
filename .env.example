# ============================================
# 企业微信-OpenCode 桥接服务配置
# 复制此文件为 .env 并填入实际值
# ============================================

# ============================================
# OpenCode 服务配置
# ============================================
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_USERNAME=admin
OPENCODE_SERVER_PASSWORD=your-strong-password-here

# ============================================
# 企业微信配置（从企业微信后台获取）
# ============================================
WECHAT_CORP_ID=your-corp-id
WECHAT_TOKEN=your-token
WECHAT_ENCODING_AES_KEY=your-encoding-aes-key

# ============================================
# 服务端口（可选，默认 3000）
# ============================================
PORT=3000

# ============================================
# API Key 配置（重要！）
# ============================================
# API Key 需要配置在 OpenCode Server 端，不是本桥接服务
# 
# 方式一：启动 OpenCode Server 时设置环境变量
#   export OPENAI_API_KEY="sk-xxx"
#   export DEEPSEEK_API_KEY="sk-xxx"
#   export ANTHROPIC_API_KEY="sk-xxx"
#   opencode serve --port 4096
#
# 方式二：写入 OpenCode 配置文件
#   运行: opencode config
#   或使用环境变量配置: export OPENCODE_PROVIDER_OPENAI_API_KEY="sk-xxx"
#
# 注意：切换模型时只需指定 provider/model，不需要重复提供 API Key
# 示例：使用模型 openai/gpt-4o
#       使用模型 deepseek/deepseek-reasoner

# ============================================
# OpenCode Server 环境变量示例（供参考）
# ============================================
# 如果使用方式一，启动 OpenCode Server 前设置：
# OPENAI_API_KEY=sk-your-openai-key
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# ANTHROPIC_API_KEY=sk-your-anthropic-key
# OPENROUTER_API_KEY=sk-your-openrouter-key
#
# 然后启动：
# nohup opencode serve --port 4096 > server.log 2>&1 &