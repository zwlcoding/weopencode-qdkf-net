# ============================================
# 企业微信-OpenCode 桥接服务配置
# 复制此文件为 .env 并填入实际值
# ============================================

# ============================================
# OpenCode Server 配置（必填）
# ============================================
OPENCODE_SERVER_USERNAME=admin
OPENCODE_SERVER_PASSWORD=your-strong-password-here

# API Keys（至少配置一个你想使用的）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-your-anthropic-key-here
OPENROUTER_API_KEY=sk-your-openrouter-key-here

# ============================================
# 桥接服务配置
# ============================================
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_USERNAME=admin
# OPENCODE_SERVER_PASSWORD 同上

# ============================================
# 企业微信配置（从企业微信后台获取）
# ============================================
WECHAT_CORP_ID=your-corp-id
WECHAT_TOKEN=your-token
WECHAT_ENCODING_AES_KEY=your-encoding-aes-key

# ============================================
# 服务端口（可选，默认 3000）
# ============================================
PORT=3000

# ============================================
# 使用说明
# ============================================
# 1. 复制本文件为 .env
# 2. 填入你的 API Keys 和密码
# 3. 运行: pm2 start ecosystem.config.cjs
# 
# 命令列表：
#   pm2 start ecosystem.config.cjs  # 启动所有服务
#   pm2 stop all                    # 停止所有服务
#   pm2 restart all                 # 重启所有服务
#   pm2 logs                        # 查看日志
#   pm2 save                        # 保存配置
#   pm2 startup                     # 设置开机自启
#
# 切换模型示例：
#   使用模型 openai/gpt-4o
#   使用模型 deepseek/deepseek-reasoner